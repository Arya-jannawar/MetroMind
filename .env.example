# MetroMind AI configuration — copy to .env.local and fill in.
# WITHOUT a key the app runs fully in deterministic "Offline AI mode"
# (rule-based explanations). The demo never depends on this key.

# z.ai (Zhipu GLM) API key — server-side only, never shipped to the client.
ZAI_API_KEY=

# Optional overrides
ZAI_MODEL=glm-4.6
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
