# MetroMind configuration — copy to .env.local and fill in.
# The app is fully functional with NO keys at all (demo dataset +
# rule-based explanations). Every integration below is optional.

# ── AI explanations — server-side only, never shipped to the client.
# Configure ONE provider (OpenAI wins unless AI_PROVIDER says otherwise).
# Without any key the app uses deterministic template explanations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER=

ZAI_API_KEY=
ZAI_MODEL=glm-4.6
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ── Live metro feed (production deployments / authority pilots).
# Any endpoint that returns the JSON contract documented on /integrations
# (and lib/livefeed.ts). When set, GET /api/live serves it server-side;
# the Integrations page can also configure a pilot feed at runtime.
# LIVE_API_KEY is sent as the LIVE_API_KEY_HEADER on every upstream request.
LIVE_FEED_URL=
LIVE_API_KEY=
LIVE_API_KEY_HEADER=x-api-key
